# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# ML Fraud Service
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=20

# Webhook
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_DELAY_MS=1000

# Reconciliation
RECON_CRON_SCHEDULE=0 2 * * *
